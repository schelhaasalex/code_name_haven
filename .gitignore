# Generated by XcodeGen — never committed
*.xcodeproj/
*.xcworkspace/

# Local configuration, including the Supabase key
Config/Secrets.xcconfig
Config/Build.xcconfig

.DS_Store
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# Claude Code: the shared hook config IS committed (.claude/settings.json);
# anything personal is not.
.claude/settings.local.json

# Written by xcodegen from project.yml
Reclaim/Info.plist
ReclaimWidgets/Info.plist

# scripts/dock-tags.sh output. boxes.csv holds every box's join secret.
boxes.csv
box-*.png
box-code.png
card-*.pdf

# What the Arduino IDE compiles. The factory station builds its own, from
# box.ino, into a scratch folder; a binary in git is one for a board nobody has.
firmware/box/build/

# Working notes and PR drafts from sessions here — never part of the product.
scratchpad/
