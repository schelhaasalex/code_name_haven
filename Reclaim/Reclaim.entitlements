<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sign in with Apple, for one optional thing: "Keep your evenings" in
       Settings ties the silent account to an Apple ID, so a new phone keeps
       the same mark. Nobody is asked to sign in to use the app. -->
  <key>com.apple.developer.applesignin</key>
  <array><string>Default</string></array>
  <!-- The box's code carries an https link, so the Camera can open the
       app with it closed. LINK_DOMAIN is set in project.yml; that
       site serves the apple-app-site-association (links/). -->
  <key>com.apple.developer.associated-domains</key>
  <array><string>applinks:$(LINK_DOMAIN)</string></array>
  <!-- Push, for the Live Activity only: the server starting the one for an
       evening the box started in the background, where iOS won't let the
       app start it (start-live-activity), and stepping its ring after
       (charge-live-activities). Automatic signing turns this into
       production for an App Store or TestFlight build. -->
  <key>aps-environment</key>
  <string>development</string>
</dict>
</plist>
